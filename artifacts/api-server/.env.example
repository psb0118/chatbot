# Postgres connection string (required by @workspace/db).
DATABASE_URL=

# Clerk backend credentials (required for every signed-in route).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Comma-separated administrator emails, checked against the Clerk profile.
ADMIN_EMAILS=

# HTTP port. Replit injects PORT automatically; local default is 5000.
PORT=5000

# Optional comma-separated browser origins when the web app is served from
# a different origin than this API. The Vite dev proxy keeps them same-origin.
# CORS_ORIGINS=http://localhost:3000

# KakaoTalk Open Builder skill server.
# Set the same value as the x-kakao-skill-secret header in the skill settings.
KAKAO_SKILL_SECRET=
# Public URL of the web app, used for webLink quick replies.
PUBLIC_APP_URL=

# Optional tuning.
# ATTENDANCE_EXP=50
# EVENT_CLAIM_WINDOW_MINUTES=5
# LOG_LEVEL=info
